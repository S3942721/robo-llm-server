#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG="$SCRIPT_DIR/config.sh"
if [[ -f "$CONFIG" ]]; then
	# shellcheck source=/dev/null
	source "$CONFIG"
else
	echo "Missing config at $CONFIG" >&2
	exit 1
fi

# Default: detached
DETACH=1

usage(){
	cat <<EOF
Usage: $0 [options]
Options:
	-a, --attach       Run attached (interactive) instead of detached (default)
	-n, --name NAME    Override model name (default: $MODEL_NAME)
	-c, --container CN Override container name (default: $CONTAINER_NAME)
	-h, --help         Show this help
EOF
}

while [[ $# -gt 0 ]]; do
	case "$1" in
		-a|--attach) DETACH=0; shift ;;
		-n|--name) MODEL_NAME="$2"; shift 2 ;;
		-c|--container) CONTAINER_NAME="$2"; shift 2 ;;
		-h|--help) usage; exit 0 ;;
		--) shift; break ;;
		-*) echo "Unknown option: $1" >&2; usage; exit 1 ;;
		*) break ;;
	esac
done

# Check if model exists in the container, create if missing
# Note: Model names in ollama are case-sensitive, so we use exact matching
echo "Checking if model '$MODEL_NAME' exists in container '$CONTAINER_NAME'..."
if ! docker exec "$CONTAINER_NAME" ollama list 2>/dev/null | awk '{print $1}' | grep -qx "$MODEL_NAME"; then
	echo "Model '$MODEL_NAME' not found. Available models:"
	docker exec "$CONTAINER_NAME" ollama list 2>/dev/null || echo "  (Unable to list models)"
	
	# Verify Modelfile exists in container
	echo "Verifying Modelfile at $CONTAINER_MODELF..."
	if ! docker exec "$CONTAINER_NAME" test -f "$CONTAINER_MODELF"; then
		echo "ERROR: Modelfile not found at $CONTAINER_MODELF inside container" >&2
		echo "Host Modelfile location: $HOST_MODELF" >&2
		echo "Please ensure the Modelfile exists and the volume mount is correct" >&2
		exit 4
	fi
	
	echo "Creating model '$MODEL_NAME' from $CONTAINER_MODELF..."
	if ! docker exec "$CONTAINER_NAME" ollama create "$MODEL_NAME" -f "$CONTAINER_MODELF"; then
		echo "Failed to create model '$MODEL_NAME'" >&2
		echo "Attempting to show Modelfile content:" >&2
		docker exec "$CONTAINER_NAME" head -20 "$CONTAINER_MODELF" 2>/dev/null || echo "  (Unable to read Modelfile)" >&2
		exit 3
	fi
	echo "Model '$MODEL_NAME' created successfully!"
else
	echo "Model '$MODEL_NAME' found in container."
fi

if [[ "$DETACH" -ne 0 ]]; then
	echo "Starting model '$MODEL_NAME' detached in container '$CONTAINER_NAME'..."
	docker exec -d "$CONTAINER_NAME" sh -c "ollama run '$MODEL_NAME'" || {
		echo "Failed to start model detached" >&2; exit 2
	}
	echo "Model '$MODEL_NAME' started (detached). Use scripts/model-attach to attach or scripts/model-stop to stop."
else
	echo "Starting model '$MODEL_NAME' attached in container '$CONTAINER_NAME'..."
	docker exec -it "$CONTAINER_NAME" ollama run "$MODEL_NAME"
fi
