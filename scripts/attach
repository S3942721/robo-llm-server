#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG="$SCRIPT_DIR/config.sh"
if [[ -f "$CONFIG" ]]; then
	# shellcheck source=/dev/null
	source "$CONFIG"
else
	echo "Missing config at $CONFIG" >&2
	exit 1
fi

docker exec -it --workdir "$CONTAINER_REPO_DIR" "$CONTAINER_NAME" /bin/bash
